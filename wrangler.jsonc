{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-portfolio",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "batuhancakir.com",
      "custom_domain": true
    },
    {
      "pattern": "www.batuhancakir.com",
      "custom_domain": true
    }
  ]
}
